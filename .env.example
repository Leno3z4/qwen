# Qwen / Alibaba Cloud
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

# AgentHub2 execution layer
AGENTHUB_URL=https://agenthub2-gray.vercel.app
AGENT_CREDENTIAL=

# Agent identity / execution context
# The credential must have trade:read and trade:write (and position:close for closes).

# Autonomous loop
TRADING_INTERVAL_MS=300000
MAX_TOOL_STEPS=10
