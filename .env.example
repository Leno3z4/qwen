# Qwen / Alibaba Cloud Model Studio
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

# AgentHub2 execution layer
AGENTHUB_URL=https://agenthub2-gray.vercel.app
# Prefer the identity access key below for automatic daily credential renewal.
AGENT_IDENTITY_ACCESS_KEY=
AGENT_NAME=Qwen Autonomous Trader
# Optional: paste a currently issued 24-hour agent credential instead.
AGENT_CREDENTIAL=
AGENT_CREDENTIAL_REFRESH_MS=43200000

# Dashboard (set this for any public deployment)
DASHBOARD_PASSWORD=

# Autonomous loop
AUTONOMOUS_ENABLED=true
TRADING_INTERVAL_MS=300000
MAX_TOOL_STEPS=10
