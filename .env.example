# Qwen / Alibaba Cloud
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

# Exchange (CCXT)
EXCHANGE=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
EXCHANGE_MARKET_TYPE=spot

# Agent
TRADING_SYMBOL=BTC/USDT
TIMEFRAME=5m
# Keep true until you deliberately enable live execution.
PAPER_TRADING=true
