# Model provider (OpenAI-compatible API)
# Free-first setup: Groq GPT-OSS 120B with Gemini fallback
MODEL_PROVIDER=groq
GROQ_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b

# Fallback model provider
# Used only for transient primary-provider failures such as rate limits, timeouts and 5xx errors.
FALLBACK_ENABLED=true
FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_MODEL=gemini-2.5-flash

# Legacy OpenRouter/Qwen-compatible variables are still accepted when MODEL_PROVIDER is not groq.
QWEN_API_KEY=
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_MODEL=qwen/qwen3-235b-a22b-2507:free

# Direct Perpl API credentials (server-side only)
# Create an API key in the Perpl UI, then set the opaque X-API-Key token and its Ed25519 private key here.
PERPL_API_URL=https://app.perpl.xyz/api
PERPL_WS_URL=wss://app.perpl.xyz
PERPL_CHAIN_ID=143
PERPL_API_KEY=
PERPL_API_PRIVATE_KEY=

# Live research layer (Tavily)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced

# Dashboard
DASHBOARD_PASSWORD=

# Autonomous loop
# Set AUTONOMOUS_ENABLED=true to let the agent run on the interval and/or at startup.
AUTONOMOUS_ENABLED=false
TRADING_INTERVAL_MS=300000
MAX_TOOL_STEPS=10

# Trading controls
# TRADING_ENABLED is a separate kill switch for actual order placement.
TRADING_ENABLED=true
ALLOW_LONG=true
ALLOW_SHORT=true
# Perpl leverage is sent in hundredths (200 = 2x).
MAX_LEVERAGE=2
