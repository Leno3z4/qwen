# Qwen-compatible model provider
QWEN_API_KEY=
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_MODEL=qwen/qwen3-235b-a22b-2507:free

# Live research layer (Tavily)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced

# AgentHub2 execution layer
AGENTHUB_URL=https://agenthub2-gray.vercel.app
# Long-lived secret stored only in Render. Qwen exchanges it for a short-lived connection token.
AGENTHUB_ACCESS_KEY=
AGENT_NAME=Qwen Autonomous Trader

# Dashboard
DASHBOARD_PASSWORD=

# Autonomous loop
# Keep false until the dashboard and execution path have been tested.
AUTONOMOUS_ENABLED=false
TRADING_INTERVAL_MS=300000
MAX_TOOL_STEPS=10
